{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build arvores",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "-I${workspaceFolder}/ARVORES/TAD ARVORE",
                "${workspaceFolder}/ARVORES/TAD ARVORE/TAD_ARVORE.c",
                "${workspaceFolder}/ARVORES/arvores.c",
                "-o",
                "${workspaceFolder}/ARVORES/arvores"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}